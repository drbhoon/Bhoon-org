# Gateway
PORT=3000
PUBLIC_ORIGIN=https://bhoon.org
PEOPLE_UPSTREAM=http://people:3001
STOCKS_UPSTREAM=http://stocks:8000

# Both application services must use the same JWT secret for SSO.
JWT_SECRET=replace_with_openssl_rand_hex_32

# People service
PEOPLE_DATABASE_URL=postgresql://user:pass@localhost:5432/bhoon_people
PEOPLE_PORT=3001
ANTHROPIC_API_KEY=
AI_REPORT_LIMIT=500

# Stocks service (starts with a fresh SQLite database; no test data is copied)
STOCKS_PORT=8000
STOCKS_DB_DATA_DIR=/app/data

# Shared OAuth settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=
ADMIN_PASSWORD=

DATABASE_URL=postgresql://user:pass@localhost:5432/ksb_personality
JWT_SECRET=replace_with_openssl_rand_hex_32
ANTHROPIC_API_KEY=sk-ant-...
AI_REPORT_LIMIT=500

# Google OAuth (same credentials as stocks.bhoon.org)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://peoplescience.bhoon.org/api/auth/google/callback
ALLOWED_EMAILS=          # optional: comma-separated whitelist, empty = allow all Google accounts

# SMTP (for report-ready emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="KSB Personality Analyser <your@gmail.com>"

APP_URL=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
NODE_ENV=development
PORT=3001
